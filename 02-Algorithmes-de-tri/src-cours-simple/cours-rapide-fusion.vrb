\frametitle{L'algorithme}
\begin{lstlisting}
def tri_rapide(t, g=0, d=None):
    if d is None:
        d = len(t) - 1
    if g < d:                    # cas de base : 0 ou 1 element
        k = partition(t, g, d)   # diviser
        tri_rapide(t, g, k - 1)  # regner a gauche
        tri_rapide(t, k + 1, d)  # regner a droite
    return t
\end{lstlisting}
\vspace{2pt}
\begin{terminaisonrec}
Le pivot est \emph{exclu} des deux appels récursifs : la taille de la tranche
$d-g+1$ décroît donc strictement à chaque appel.
\end{terminaisonrec}
\begin{correction}[Correction (récurrence sur la taille de la tranche)]
\small
Après la partition, $t[k]$ est à sa place et tout élément à sa gauche lui est
inférieur ou égal, tout élément à sa droite lui est supérieur. Si les deux tranches
sont triées, le tout est trié.
\end{correction}
